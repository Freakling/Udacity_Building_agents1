# Rename this file to config.env and fill in your actual API keys.
# Never commit config.env to version control.

# ── Option A: Claude / Anthropic (recommended for local use) ─────────────────
# Get a key at https://console.anthropic.com
# When ANTHROPIC_API_KEY is set, Claude + local embeddings are used automatically.
ANTHROPIC_API_KEY="sk-ant-..."

# ── Option B: OpenAI (required for Udacity workspace) ────────────────────────
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://openai.vocareum.com/v1"   # use https://api.openai.com/v1 for direct OpenAI

# ── Tavily web search (required for both options) ─────────────────────────────
# Free tier at https://tavily.com — 1000 searches/month
TAVILY_API_KEY="tvly-..."
